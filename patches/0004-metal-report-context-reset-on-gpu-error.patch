From ff4f6aab6f98f87bc03dc113059bddaea6fc33a6 Mon Sep 17 00:00:00 2001
From: Homura <egzozu.be1.bas@gmail.com>
Date: Sun, 14 Jun 2026 13:53:43 +0300
Subject: [PATCH] Metal: report context reset on device-loss command buffer
 errors

ContextMtl::getResetStatus() always returned NoError, so when a command buffer completed with a device-loss-class error (GPU timeout/watchdog, page fault, or GPU access revoked while backgrounding on iOS) the failure was only logged and then ignored. The context kept running with state the GPU had already lost, producing corrupted rendering with no way to recover.

Latch those errors on command buffer completion and report them through getResetStatus() as a context reset, so a robustness-aware client can detect the loss and rebuild.
---
 src/libANGLE/renderer/metal/ContextMtl.mm         |  7 +++++++
 src/libANGLE/renderer/metal/mtl_command_buffer.h  |  5 +++++
 src/libANGLE/renderer/metal/mtl_command_buffer.mm | 15 +++++++++++++++
 3 files changed, 27 insertions(+)

diff --git a/src/libANGLE/renderer/metal/ContextMtl.mm b/src/libANGLE/renderer/metal/ContextMtl.mm
index 60c7948467..acabb3a2fc 100644
--- a/src/libANGLE/renderer/metal/ContextMtl.mm
+++ b/src/libANGLE/renderer/metal/ContextMtl.mm
@@ -1065,6 +1065,13 @@ angle::Result ContextMtl::multiDrawElementsInstancedBaseVertexBaseInstance(
 // Device loss
 gl::GraphicsResetStatus ContextMtl::getResetStatus()
 {
+    // A command buffer that completed with a device-loss-class error (GPU hang, page fault,
+    // or revoked GPU access) means previously submitted work was lost. Report it as a context
+    // reset so a robustness-aware client can rebuild instead of rendering with corrupt state.
+    if (mCmdBuffer.cmdQueue().isDeviceLost())
+    {
+        return gl::GraphicsResetStatus::UnknownContextReset;
+    }
     return gl::GraphicsResetStatus::NoError;
 }
 
diff --git a/src/libANGLE/renderer/metal/mtl_command_buffer.h b/src/libANGLE/renderer/metal/mtl_command_buffer.h
index 443f2e4cca..4eaa074270 100644
--- a/src/libANGLE/renderer/metal/mtl_command_buffer.h
+++ b/src/libANGLE/renderer/metal/mtl_command_buffer.h
@@ -126,6 +126,10 @@ class CommandQueue final : public WrappedObject<id<MTLCommandQueue>>, angle::Non
     double getTimeElapsedEntryInSeconds(uint64_t id);
     MTLCommandBufferError popCmdBufferError() { return mCmdBufferError.pop(); }
 
+    // Sticky flag: set when a command buffer completes with a device-loss-class error
+    // (GPU timeout, page fault, access revoked). Used to surface a context reset.
+    bool isDeviceLost() const { return mDeviceLost.load(std::memory_order_acquire); }
+
   private:
     using ParentClass = WrappedObject<id<MTLCommandQueue>>;
 
@@ -174,6 +178,7 @@ class CommandQueue final : public WrappedObject<id<MTLCommandQueue>>, angle::Non
     mutable std::condition_variable mCompletedBufferSerialCv;
 
     AtomicCommandBufferError mCmdBufferError;
+    std::atomic<bool> mDeviceLost{false};
 
     angle::HashMap<uint64_t, std::vector<std::function<void()>>> mCommandBufferScheduledCallbacks;
 };
diff --git a/src/libANGLE/renderer/metal/mtl_command_buffer.mm b/src/libANGLE/renderer/metal/mtl_command_buffer.mm
index 0decccbae0..4904dbc76e 100644
--- a/src/libANGLE/renderer/metal/mtl_command_buffer.mm
+++ b/src/libANGLE/renderer/metal/mtl_command_buffer.mm
@@ -693,6 +693,21 @@ void CommandQueue::onCommandBufferCompleted(id<MTLCommandBuffer> buf,
         ERR() << "Completed MTLCommandBuffer failed, and error is "
               << error.localizedDescription.UTF8String;
         mCmdBufferError.store(static_cast<MTLCommandBufferError>(error.code));
+
+        // GPU work for this submission was lost (hang/watchdog, page fault, or GPU access
+        // revoked while backgrounding on iOS). Latch it so ContextMtl::getResetStatus() can
+        // report a context reset instead of silently continuing with corrupt GPU state.
+        switch (static_cast<MTLCommandBufferError>(error.code))
+        {
+            case MTLCommandBufferErrorTimeout:
+            case MTLCommandBufferErrorPageFault:
+            case MTLCommandBufferErrorAccessRevoked:
+            case MTLCommandBufferErrorNotPermitted:
+                mDeviceLost.store(true, std::memory_order_release);
+                break;
+            default:
+                break;
+        }
     }
 
     if (timeElapsedEntry != 0)
-- 
2.47.3

